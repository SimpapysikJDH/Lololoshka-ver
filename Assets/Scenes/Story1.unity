--- !u!114 &145644239
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 145644238}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 851008b959f17a44aaf4a8633f94f374, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogueTrigger
  dialogueLines:
  - speakerName: ???
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u041F\u0440\u0438\u0432\u0456\u0442, \u044F \u0442\u0430\u043A \u0440\u043E\u0437\u0443\u043C\u0456\u044E
      \u0442\u0438 \u0442\u0435\u0436 \u0442\u0443\u0442 \u0437\u0430\u0441\u0442\u0440\u044F\u0433
      \u043F\u0456\u0441\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0435\u043D\u043D\u044F?"
  - speakerName: ZOBBI
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u041C\u0435\u043D\u0435 \u0437\u0432\u0430\u0442\u0438 \u0417\u043E\u0431\u0456!"
  - speakerName: "\u042F?"
    portrait: {fileID: 21300000, guid: 8df4debbc9214cf4dadb49b4da203e9f, type: 3}
    text: "\u0414\u0435 \u044F? \u042F \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
      \u043F\u0430\u043C'\u044F\u0442\u0430\u044E"
  - speakerName: ZOBBI
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u0422\u0438 \u043B\u044E\u0434\u0438\u043D\u0430, \u044F\u043A\u0430
      \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0430 \u0434\u0430\u0440 \u0434\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F!"
  - speakerName: ZOBBI
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u0410\u043B\u0435 \u0432 \u0446\u044C\u043E\u043C\u0443 \u0441\u0432\u0456\u0442\u0456
      \u043D\u0430\u0448\u0443 \u0441\u0438\u043B\u0443 \u0449\u043E\u0441\u044C
      \u0431\u043B\u043E\u043A\u0443\u0454..."
  - speakerName: ZOBBI
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u0417\u0430\u0440\u0430\u0437 \u0442\u043E\u0431\u0456 \u0449\u043E\u0441\u044C
      \u0434\u0430\u043C \u0456 \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448
      \u0432\u0438\u043A\u0438\u0434\u0443\u0432\u0430\u0442\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043A\u0443
      \u0441\u0432\u043E\u0454\u0457 \u0441\u0438\u043B\u0438"
  - speakerName: ZOBBI
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u0410\u043B\u0435 \u043D\u0435 \u0431\u0456\u0439\u0441\u044F \u0441\u0438\u043B\u0430
      \u0431\u0443\u0434\u0435 \u0434\u043E \u0442\u0435\u0431\u0435 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0442\u0438\u0441\u044F"
  - speakerName: "\u042F"
    portrait: {fileID: 21300000, guid: 8df4debbc9214cf4dadb49b4da203e9f, type: 3}
    text: "\u0410 \u0434\u043B\u044F \u0447\u043E\u0433\u043E \u0432\u043E\u043D\u043E
      \u043C\u0435\u043D\u0456?"
  - speakerName: ZOBBI
    portrait: {fileID: 21300000, guid: 084854c35a49f1943845862fe394b55f, type: 3}
    text: "\u0422\u0443\u0442 \u0431\u0443\u0432\u0430\u044E\u0442\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u0438
      \u0442\u043E\u043C\u0443 \u0432\u043E\u043D\u0430 \u0442\u043E\u0431\u0456
      \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435!"
  interactPrompt: {fileID: 1374398254}
  interactKey: 19
  unlockPlayerAttack: 0
  triggerOnce: 0
  autoStartOnEnter: 0
  onDialogueComplete:
    m_PersistentCalls:
